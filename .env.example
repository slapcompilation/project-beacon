# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Vite reads env vars from apps/web/.env.local, NOT the repo root.
# Create apps/web/.env.local for all VITE_* variables.
# This root .env.example is for documentation and server-side vars only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── apps/web/.env.local ──────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# OAuth sign-in buttons to show (comma-separated): google,azure  (azure = Microsoft).
# Each must ALSO be enabled in Supabase → Authentication → Providers, and
# https://<your-domain>/auth/callback added to the allowed Redirect URLs.
# VITE_OAUTH_PROVIDERS=google,azure
#
# Self-hosted basemap (portfolio + hotel-location maps). Point these at the public
# `basemap` bucket (migration 195) once the PMTiles + Protomaps assets are uploaded.
# Unset → the map renders the tile-free SVG pin map (never blocked, never black).
# Two tiers: detail = street-level bbox extract around the hotels; world = whole
# planet at low zoom, rendered below VITE_BASEMAP_WORLD_MAXZOOM (default 8).
# VITE_BASEMAP_PMTILES_URL=https://<project>.supabase.co/storage/v1/object/public/basemap/attica-z15.pmtiles
# VITE_BASEMAP_MAXZOOM=15
# VITE_BASEMAP_WORLD_PMTILES_URL=https://<project>.supabase.co/storage/v1/object/public/basemap/planet.pmtiles
# VITE_BASEMAP_WORLD_MAXZOOM=8
# VITE_BASEMAP_GLYPHS_URL=https://<project>.supabase.co/storage/v1/object/public/basemap/fonts/{fontstack}/{range}.pbf
# VITE_BASEMAP_SPRITE_URL=https://<project>.supabase.co/storage/v1/object/public/basemap/sprites/dark
# Escape hatch — a full external style URL instead of the self-hosted basemap:
# VITE_MAP_STYLE_URL=

# ─── Root .env.local (server-side / edge functions only) ─────────────────────
SUPABASE_SECRET_KEY=          # never use VITE_ prefix — must not reach the browser

# ─── AI Provider (Phase 6) ────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Rate Limiting — Upstash Redis (Phase 5) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
