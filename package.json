{
  "name": "project-beacon",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "check:edge": "node scripts/check-edge-syntax.mjs",
    "check:rpcs": "node scripts/check-rpcs.mjs",
    "check:shape": "node scripts/audit-shape.mjs --check",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "build:edge-bundle": "pnpm dlx esbuild@0.25.12 packages/reality-graph/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/reality-graph.bundle.mjs",
    "db": "node scripts/db.mjs",
    "db:status": "node scripts/db.mjs --status",
    "db:migrate": "node scripts/db.mjs --migrate",
    "db:baseline": "node scripts/db.mjs --baseline",
    "gen:ontology": "node scripts/generate-ontology-types.mjs",
    "gen:ontology:check": "node scripts/generate-ontology-types.mjs --check"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
